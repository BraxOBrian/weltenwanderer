---
import { navigation } from '../data/navigation';
import NavIcon from './NavIcon.astro';
---
<nav class="mobile-nav" aria-label="Hauptnavigation">
  <details>
    <summary>Menü <span aria-hidden="true">☰</span></summary>
    <ul>
      {navigation.map(({ label, icon, current }) => (
        <li><span class:list={['mobile-label', { 'is-current': current }]} role="link" aria-disabled="true" aria-current={current ? 'page' : undefined}><NavIcon name={icon} />{label}</span></li>
      ))}
    </ul>
  </details>
</nav>
