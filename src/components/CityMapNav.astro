---
import { Image } from 'astro:assets';
import map from '../assets/desktop_nav.png';
import { navigation } from '../data/navigation';
import NavIcon from './NavIcon.astro';
---
<nav class="map-nav" aria-label="Hauptnavigation">
  <div class="map-surface">
    <Image src={map} alt="" widths={[960, 1440, 1672]} sizes="(max-width: 1200px) 100vw, 1200px" format="webp" loading="eager" fetchpriority="high" />
    <ul>
      {navigation.map(({ label, icon, x, y, current }) => (
        <li style={`--x: ${x}%; --y: ${y}%`}>
          <span class:list={['nav-label', { 'is-current': current }]} role="link" aria-disabled="true" aria-current={current ? 'page' : undefined}>
            <NavIcon name={icon} /><span>{label}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</nav>
